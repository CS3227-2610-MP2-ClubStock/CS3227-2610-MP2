<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="clubstock.ui.controller.MemberActiveLoansController"
            styleClass="role-shell, member-shell">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="shell-bar">
            <padding>
                <Insets top="16" right="24" bottom="16" left="24" />
            </padding>
            <Button text="_Back" mnemonicParsing="true" onAction="#goBack"
                    styleClass="secondary-button" />
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <children>
                    <Label text="ClubStock" styleClass="shell-brand" />
                    <Label text="MEMBER WORKSPACE" styleClass="shell-role" />
                </children>
            </VBox>
            <Button fx:id="refreshButton" text="_Refresh" mnemonicParsing="true"
                    onAction="#refresh"
                    styleClass="secondary-button" />
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="AS_NEEDED" styleClass="content-scroll">
            <content>
                <VBox maxWidth="1180" spacing="18" styleClass="admin-content">
                    <padding>
                        <Insets top="28" right="32" bottom="32" left="32" />
                    </padding>
                    <VBox spacing="6">
                        <children>
                            <Label text="MEMBER LOANS" styleClass="eyebrow" />
                            <Label text="My loans" styleClass="screen-title" />
                            <Label text="Each assigned item is listed separately. Overdue applies only to an ON_LOAN item past its end date."
                                   styleClass="supporting-text" wrapText="true" />
                        </children>
                    </VBox>
                    <VBox spacing="14" styleClass="account-form-card">
                        <children>
                            <Label text="Active loans" styleClass="section-title" />
                            <Label fx:id="loadingLabel" text="Loading your loans…"
                                   styleClass="supporting-text" visible="false" managed="false" />
                            <Label fx:id="emptyStateLabel" text="You have no active loans."
                                   styleClass="catalog-empty-text" visible="false" managed="false"
                                   wrapText="true" />
                            <Label fx:id="errorLabel" text="" styleClass="error-text"
                                   visible="false" managed="false" wrapText="true" />
                            <TableView fx:id="loansTable" prefHeight="380" minWidth="850"
                                       accessibleText="Your unresolved individual loans and overdue status"
                                       visible="false" managed="false" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="equipmentTypeColumn" prefWidth="170"
                                                 text="Equipment type" />
                                    <TableColumn fx:id="equipmentIdColumn" prefWidth="130"
                                                 text="Equipment ID" />
                                    <TableColumn fx:id="statusColumn" prefWidth="135"
                                                 text="Status" />
                                    <TableColumn fx:id="startedAtColumn" prefWidth="190"
                                                 text="Start date/time" />
                                    <TableColumn fx:id="endDateColumn" prefWidth="130"
                                                 text="End date" />
                                    <TableColumn fx:id="overdueColumn" prefWidth="110"
                                                 text="Overdue" />
                                </columns>
                            </TableView>
                        </children>
                    </VBox>
                    <VBox spacing="12" styleClass="account-form-card">
                        <children>
                            <Label text="Loan actions" styleClass="section-title" />
                            <Label text="Select one of your ON_LOAN items to return it or report it lost."
                                   styleClass="supporting-text" wrapText="true" />
                            <HBox spacing="10">
                                <children>
                                    <Button fx:id="returnActionButton" text="Return"
                                            onAction="#openReturnForm" styleClass="primary-button"
                                            disable="true" />
                                    <Button fx:id="lostActionButton" text="Report Lost"
                                            onAction="#openLostForm" styleClass="secondary-button"
                                            disable="true" />
                                </children>
                            </HBox>
                            <Label fx:id="operationMessageLabel" text="" visible="false"
                                   managed="false" wrapText="true" />
                            <VBox fx:id="returnForm" spacing="12" visible="false"
                                  managed="false" styleClass="account-form-card">
                                <children>
                                    <Label text="Return selected item" styleClass="section-title" />
                                    <Label text="Choose the condition you observed. Exco will verify the item."
                                           styleClass="supporting-text" wrapText="true" />
                                    <HBox spacing="18">
                                        <children>
                                            <RadioButton fx:id="goodReturnRadioButton" text="Good condition"
                                                         selected="true" />
                                            <RadioButton fx:id="damagedReturnRadioButton" text="Damaged" />
                                        </children>
                                    </HBox>
                                    <VBox fx:id="damagedReturnFields" spacing="10"
                                          visible="false" managed="false">
                                        <children>
                                            <Label text="Damage description" styleClass="field-label" />
                                            <TextArea fx:id="damageDescriptionArea" prefRowCount="3"
                                                      wrapText="true"
                                                      promptText="Describe the damage" />
                                            <Label text="Damage image (JPEG or PNG)"
                                                   styleClass="field-label" />
                                            <HBox spacing="10" alignment="CENTER_LEFT">
                                                <children>
                                                    <Button fx:id="chooseDamageImageButton"
                                                            text="Choose image…"
                                                            onAction="#chooseDamageImage"
                                                            styleClass="secondary-button" />
                                                    <Label fx:id="selectedDamageImageLabel"
                                                           text="No image selected"
                                                           styleClass="supporting-text"
                                                           wrapText="true" />
                                                </children>
                                            </HBox>
                                        </children>
                                    </VBox>
                                    <HBox spacing="10">
                                        <children>
                                            <Button fx:id="submitReturnButton" text="Submit Return"
                                                    onAction="#submitReturn"
                                                    styleClass="primary-button" />
                                            <Button fx:id="cancelReturnButton" text="Cancel"
                                                    onAction="#cancelReturn"
                                                    styleClass="secondary-button" />
                                        </children>
                                    </HBox>
                                </children>
                            </VBox>
                            <VBox fx:id="lostForm" spacing="12" visible="false"
                                  managed="false" styleClass="account-form-card">
                                <children>
                                    <Label text="Report selected item lost" styleClass="section-title" />
                                    <Label text="Describe what happened. Exco will review the report."
                                           styleClass="supporting-text" wrapText="true" />
                                    <Label text="Loss description" styleClass="field-label" />
                                    <TextArea fx:id="lossDescriptionArea" prefRowCount="3"
                                              wrapText="true"
                                              promptText="Describe the loss" />
                                    <HBox spacing="10">
                                        <children>
                                            <Button fx:id="submitLostButton" text="Submit Lost Report"
                                                    onAction="#submitLost"
                                                    styleClass="primary-button" />
                                            <Button fx:id="cancelLostButton" text="Cancel"
                                                    onAction="#cancelLost"
                                                    styleClass="secondary-button" />
                                        </children>
                                    </HBox>
                                </children>
                            </VBox>
                        </children>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
