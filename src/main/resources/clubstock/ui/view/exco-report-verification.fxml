<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="clubstock.ui.controller.ExcoReportVerificationController"
      styleClass="role-shell,exco-shell">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="shell-bar">
            <padding><Insets top="16" right="24" bottom="16" left="24" /></padding>
            <Button text="_Back" mnemonicParsing="true" onAction="#goBack" styleClass="secondary-button" />
            <VBox spacing="2">
                <Label text="Verify pending reports" styleClass="screen-title" />
                <Label text="Review Member advisory evidence before authoritatively resolving each item."
                       styleClass="supporting-text" wrapText="true" />
            </VBox>
        </HBox>
    </top>
    <center>
        <VBox spacing="12">
            <padding><Insets top="20" right="24" bottom="16" left="24" /></padding>
            <TableView fx:id="reportsTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="memberColumn" prefWidth="220" text="Member" />
                <TableColumn fx:id="typeColumn" prefWidth="220" text="Equipment type" />
                <TableColumn fx:id="equipmentIdColumn" prefWidth="220" text="Equipment ID" />
                <TableColumn fx:id="kindColumn" prefWidth="160" text="Report" />
                <TableColumn fx:id="conditionColumn" visible="false" text="Reported condition" />
                <TableColumn fx:id="imageAvailableColumn" visible="false" text="Damage image" />
                <TableColumn fx:id="evidenceColumn" visible="false" text="Advisory details" />
            </columns>
            </TableView>
            <VBox spacing="5" styleClass="account-form-card">
                <Label text="Selected report" styleClass="section-title" />
                <Label fx:id="reportDetailsLabel" text="Select a report to review its advisory details."
                       wrapText="true" styleClass="supporting-text" />
            </VBox>
        </VBox>
    </center>
    <bottom>
        <VBox spacing="8" styleClass="shell-bar">
            <padding><Insets top="12" right="24" bottom="12" left="24" /></padding>
            <FlowPane hgap="8" vgap="8">
                <Button fx:id="goodButton" text="Verify _good" mnemonicParsing="true"
                        onAction="#verifyGood" styleClass="primary-button" />
                <Button fx:id="damagedAvailableButton" text="Damaged: _available"
                        mnemonicParsing="true" onAction="#verifyDamagedAvailable" styleClass="secondary-button" />
                <Button fx:id="damagedUnavailableButton" text="Damaged: _unavailable"
                        mnemonicParsing="true" onAction="#verifyDamagedUnavailable" styleClass="secondary-button" />
                <Button fx:id="lostButton" text="Confirm _lost" mnemonicParsing="true"
                        onAction="#confirmLost" styleClass="danger-button" />
            </FlowPane>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Button fx:id="viewImageButton" text="View _damage image" mnemonicParsing="true"
                        onAction="#viewDamageImage" styleClass="secondary-button" />
                <Button text="_Refresh" mnemonicParsing="true" onAction="#refresh"
                        styleClass="secondary-button" />
                <Label fx:id="statusLabel" styleClass="supporting-text" wrapText="true" />
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
