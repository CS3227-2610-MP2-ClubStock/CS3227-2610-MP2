<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="clubstock.ui.controller.MemberAdministrationController"
            styleClass="role-shell,exco-shell">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="shell-header">
            <padding>
                <Insets bottom="16.0" left="24.0" right="24.0" top="16.0" />
            </padding>
            <Button mnemonicParsing="true" onAction="#goBack" styleClass="secondary-button" text="_Back" />
            <VBox spacing="2.0">
                <Label styleClass="screen-title" text="Member administration" />
                <Label styleClass="supporting-text" text="Create, update, and safely deactivate Member accounts." />
            </VBox>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="admin-scroll-pane">
            <content>
                <VBox maxWidth="1080.0" spacing="18.0" styleClass="admin-content">
                    <padding>
                        <Insets bottom="32.0" left="32.0" right="32.0" top="8.0" />
                    </padding>
                    <Label styleClass="supporting-text"
                           text="Select a Member to edit or deactivate their account. Member IDs cannot be changed." />
                    <HBox alignment="CENTER_RIGHT" spacing="12.0">
                        <Button mnemonicParsing="true"
                                onAction="#openCreateDialog"
                                styleClass="primary-button"
                                text="Create _Member" />
                        <Button fx:id="editMemberButton"
                                mnemonicParsing="true"
                                onAction="#openEditDialog"
                                styleClass="secondary-button"
                                text="_Edit selected Member" />
                    </HBox>
                    <TableView fx:id="membersTable" prefHeight="320.0" styleClass="member-table">
                        <columns>
                            <TableColumn fx:id="memberIdColumn" prefWidth="190.0" text="Member ID" />
                            <TableColumn fx:id="memberNameColumn" prefWidth="350.0" text="Name" />
                            <TableColumn fx:id="memberStatusColumn" prefWidth="160.0" text="Status" />
                        </columns>
                    </TableView>
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Button mnemonicParsing="true"
                                onAction="#refreshMembers"
                                styleClass="secondary-button"
                                text="_Refresh" />
                        <Label fx:id="statusLabel" styleClass="error-text" wrapText="true" />
                    </HBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
