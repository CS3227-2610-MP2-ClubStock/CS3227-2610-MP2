<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ScrollPane?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="clubstock.ui.controller.ExcoHomeController"
            styleClass="role-shell, exco-shell">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="shell-bar">
            <padding>
                <Insets top="16" right="24" bottom="16" left="24"/>
            </padding>
            <children>
                <VBox HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="ClubStock" styleClass="shell-brand"/>
                        <Label text="EXCO WORKSPACE" styleClass="shell-role"/>
                    </children>
                </VBox>
                <Button text="_Log out" mnemonicParsing="true" onAction="#logout"
                        styleClass="secondary-button"/>
            </children>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
            <content>
                <VBox maxWidth="1080" spacing="24" styleClass="dashboard-content">
                    <padding>
                        <Insets top="36" right="32" bottom="40" left="32"/>
                    </padding>
                    <children>
                        <VBox spacing="8" styleClass="dashboard-header">
                            <children>
                                <Label text="EXCO ADMINISTRATION" styleClass="eyebrow"/>
                                <Label text="Exco home" styleClass="dashboard-title"/>
                                <Label text="Manage Member accounts and equipment operations from one place."
                                       styleClass="supporting-text" wrapText="true"/>
                            </children>
                        </VBox>
                        <TilePane hgap="16" prefColumns="3" prefTileHeight="168" prefTileWidth="330"
                                  tileAlignment="TOP_LEFT" vgap="16" styleClass="dashboard-grid">
                            <children>
                                <Button accessibleText="Manage Members. Create, edit, or remove Member accounts."
                                        maxHeight="Infinity" maxWidth="Infinity" mnemonicParsing="false"
                                        onAction="#manageMembers" styleClass="dashboard-card, dashboard-card-primary">
                                    <graphic>
                                        <VBox alignment="TOP_LEFT" spacing="8">
                                            <children>
                                                <Label text="👥" styleClass="dashboard-card-icon"/>
                                                <Label text="Manage Members" styleClass="dashboard-card-title"/>
                                                <Label text="Create, edit, or remove Member accounts."
                                                       styleClass="dashboard-card-description" wrapText="true"/>
                                            </children>
                                        </VBox>
                                    </graphic>
                                </Button>
                                <Button accessibleText="Manage Inventory. Maintain equipment types and physical items."
                                        maxHeight="Infinity" maxWidth="Infinity" mnemonicParsing="false"
                                        onAction="#manageInventory" styleClass="dashboard-card">
                                    <graphic>
                                        <VBox alignment="TOP_LEFT" spacing="8">
                                            <children>
                                                <Label text="▦" styleClass="dashboard-card-icon"/>
                                                <Label text="Manage Inventory" styleClass="dashboard-card-title"/>
                                                <Label text="Maintain equipment types and physical items."
                                                       styleClass="dashboard-card-description" wrapText="true"/>
                                            </children>
                                        </VBox>
                                    </graphic>
                                </Button>
                                <Button accessibleText="Manage Pending Requests. Review and allocate pending loan requests."
                                        maxHeight="Infinity" maxWidth="Infinity" mnemonicParsing="false"
                                        onAction="#manageRequests" styleClass="dashboard-card">
                                    <graphic>
                                        <VBox alignment="TOP_LEFT" spacing="8">
                                            <children>
                                                <Label text="↗" styleClass="dashboard-card-icon"/>
                                                <Label text="Manage Pending Requests" styleClass="dashboard-card-title"/>
                                                <Label text="Review and allocate pending loan requests."
                                                       styleClass="dashboard-card-description" wrapText="true"/>
                                            </children>
                                        </VBox>
                                    </graphic>
                                </Button>
                                <Button accessibleText="View Active Loans. Check current and overdue equipment loans."
                                        maxHeight="Infinity" maxWidth="Infinity" mnemonicParsing="false"
                                        onAction="#manageLoans" styleClass="dashboard-card">
                                    <graphic>
                                        <VBox alignment="TOP_LEFT" spacing="8">
                                            <children>
                                                <Label text="◷" styleClass="dashboard-card-icon"/>
                                                <Label text="View Active Loans" styleClass="dashboard-card-title"/>
                                                <Label text="Check current and overdue equipment loans."
                                                       styleClass="dashboard-card-description" wrapText="true"/>
                                            </children>
                                        </VBox>
                                    </graphic>
                                </Button>
                                <Button accessibleText="Verify Pending Reports. Resolve submitted return and loss reports."
                                        maxHeight="Infinity" maxWidth="Infinity" mnemonicParsing="false"
                                        onAction="#verifyReports" styleClass="dashboard-card">
                                    <graphic>
                                        <VBox alignment="TOP_LEFT" spacing="8">
                                            <children>
                                                <Label text="✓" styleClass="dashboard-card-icon"/>
                                                <Label text="Verify Pending Reports" styleClass="dashboard-card-title"/>
                                                <Label text="Resolve submitted return and loss reports."
                                                       styleClass="dashboard-card-description" wrapText="true"/>
                                            </children>
                                        </VBox>
                                    </graphic>
                                </Button>
                            </children>
                        </TilePane>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
