<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="clubstock.ui.controller.MemberOwnRequestsController"
            styleClass="role-shell, member-shell">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="shell-bar">
            <padding>
                <Insets top="16" right="24" bottom="16" left="24" />
            </padding>
            <Button text="_Back" mnemonicParsing="true" onAction="#goBack"
                    styleClass="secondary-button" fx:id="backButton" />
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <children>
                    <Label text="ClubStock" styleClass="shell-brand" />
                    <Label text="MEMBER WORKSPACE" styleClass="shell-role" />
                </children>
            </VBox>
            <Button text="_Refresh" mnemonicParsing="true" onAction="#refreshRequests"
                    styleClass="secondary-button" fx:id="refreshButton" />
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
            <content>
                <VBox maxWidth="1180" spacing="18" styleClass="admin-content">
                    <padding>
                        <Insets top="28" right="32" bottom="32" left="32" />
                    </padding>
                    <VBox spacing="6">
                        <children>
                            <Label text="MEMBER REQUESTS" styleClass="eyebrow" />
                            <Label text="Your requests" styleClass="screen-title" />
                            <Label text="Review request status and approved quantities. Only pending requests can be cancelled."
                                   styleClass="supporting-text" wrapText="true" />
                        </children>
                    </VBox>
                    <VBox spacing="14" styleClass="account-form-card">
                        <children>
                            <Label text="Request history" styleClass="section-title" />
                            <Label fx:id="loadingLabel" text="Loading your requests…"
                                   styleClass="supporting-text" visible="false" managed="false" />
                            <Label fx:id="emptyStateLabel" text="You have not submitted any requests yet."
                                   styleClass="catalog-empty-text" visible="false" managed="false"
                                   wrapText="true" />
                            <Label fx:id="errorLabel" text="" styleClass="error-text"
                                   visible="false" managed="false" wrapText="true" />
                            <TableView fx:id="requestsTable" prefHeight="380"
                                       accessibleText="Your loan requests and their current status"
                                       visible="false" managed="false" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="equipmentTypeColumn" prefWidth="210"
                                                 text="Equipment type" />
                                    <TableColumn fx:id="requestedQuantityColumn" prefWidth="100"
                                                 text="Requested" />
                                    <TableColumn fx:id="startDateColumn" prefWidth="120"
                                                 text="Start date" />
                                    <TableColumn fx:id="endDateColumn" prefWidth="120"
                                                 text="End date" />
                                    <TableColumn fx:id="statusColumn" prefWidth="120"
                                                 text="Status" />
                                    <TableColumn fx:id="requestedAtColumn" prefWidth="190"
                                                 text="Submitted" />
                                    <TableColumn fx:id="approvedQuantityColumn" prefWidth="140"
                                                 text="Approved quantity" />
                                </columns>
                            </TableView>
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <children>
                                    <Button fx:id="cancelButton" text="_Cancel selected request"
                                            mnemonicParsing="true" onAction="#cancelSelectedRequest"
                                            styleClass="danger-button" disable="true" />
                                    <Label text="Select one of your pending requests to cancel it."
                                           styleClass="supporting-text" wrapText="true" />
                                </children>
                            </HBox>
                            <Label fx:id="statusLabel" minHeight="24" wrapText="true"
                                   styleClass="supporting-text" />
                        </children>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
