<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="clubstock.ui.controller.MemberLoginController"
           styleClass="app-background">
    <padding>
        <Insets top="36" right="36" bottom="36" left="36"/>
    </padding>
    <VBox alignment="CENTER_LEFT" maxWidth="520" spacing="16" styleClass="surface-card">
        <children>
            <Label text="MEMBER ACCESS" styleClass="eyebrow"/>
            <Label text="Member sign in" styleClass="screen-title"/>
            <Label text="The Member sign-in form is supplied by the Member authentication implementation and is not available in this build yet."
                   styleClass="supporting-text" wrapText="true"/>
            <Button text="_Back to role selection" mnemonicParsing="true" defaultButton="true"
                    onAction="#goBack" styleClass="secondary-button"/>
        </children>
    </VBox>
</StackPane>
