<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="clubstock.ui.controller.RoleSelectionController"
           styleClass="app-background">
    <padding>
        <Insets top="36" right="36" bottom="36" left="36"/>
    </padding>
    <VBox alignment="CENTER_LEFT" maxWidth="620" spacing="18" styleClass="surface-card">
        <children>
            <Label text="ClubStock" styleClass="app-title"/>
            <Label text="CCA equipment loans" styleClass="eyebrow"/>
            <Label text="How would you like to sign in?" styleClass="screen-title" wrapText="true"/>
            <Label text="Choose the role for this session. Each role opens a separate, protected workspace."
                   styleClass="supporting-text" wrapText="true"/>
            <HBox spacing="12">
                <children>
                    <Button text="_Exco" mnemonicParsing="true" onAction="#selectExco"
                            prefWidth="180" styleClass="primary-button"/>
                    <Button text="_Member" mnemonicParsing="true" onAction="#selectMember"
                            prefWidth="180" styleClass="secondary-button"/>
                </children>
            </HBox>
            <Label fx:id="errorLabel" accessibleRoleDescription="Sign-in error"
                   minHeight="24" styleClass="error-text" wrapText="true"/>
        </children>
    </VBox>
</StackPane>
