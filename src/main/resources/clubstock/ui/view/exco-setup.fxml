<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="clubstock.ui.controller.ExcoSetupController"
           styleClass="app-background">
    <padding>
        <Insets top="36" right="36" bottom="36" left="36"/>
    </padding>
    <VBox alignment="CENTER_LEFT" maxWidth="560" spacing="14" styleClass="surface-card">
        <children>
            <Label text="EXCO ACCESS" styleClass="eyebrow"/>
            <Label text="Set up the Exco password" styleClass="screen-title" wrapText="true"/>
            <Label text="This first-run setup is required once for the pre-created Exco account. Use at least eight characters and include a non-whitespace character."
                   styleClass="supporting-text" wrapText="true"/>
            <Label fx:id="passwordLabel" text="_Password" mnemonicParsing="true"
                   styleClass="field-label"/>
            <PasswordField fx:id="passwordField" promptText="Enter a password"
                           accessibleHelp="At least eight characters"/>
            <Label fx:id="confirmationLabel" text="_Confirm password" mnemonicParsing="true"
                   styleClass="field-label"/>
            <PasswordField fx:id="confirmationField" promptText="Enter the password again"/>
            <Label fx:id="errorLabel" accessibleRoleDescription="Setup error"
                   minHeight="24" styleClass="error-text" wrapText="true"/>
            <HBox spacing="12">
                <children>
                    <Button text="_Set password" mnemonicParsing="true" defaultButton="true"
                            onAction="#completeSetup" styleClass="primary-button"/>
                    <Button text="_Back" mnemonicParsing="true" cancelButton="true"
                            onAction="#goBack" styleClass="secondary-button"/>
                </children>
            </HBox>
        </children>
    </VBox>
</StackPane>
