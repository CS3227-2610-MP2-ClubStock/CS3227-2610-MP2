<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="clubstock.ui.controller.ExcoRequestQueueController"
            styleClass="role-shell,exco-shell">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="shell-bar">
            <padding>
                <Insets bottom="16.0" left="24.0" right="24.0" top="16.0" />
            </padding>
            <Button mnemonicParsing="true" onAction="#goBack" styleClass="secondary-button" text="_Back" />
            <VBox spacing="2.0">
                <Label styleClass="screen-title" text="Pending LoanRequests" />
                <Label styleClass="supporting-text"
                       text="Review Member requests in submission order and reject only requests that remain pending." />
            </VBox>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
            <content>
                <VBox maxWidth="1180.0" spacing="16.0" styleClass="admin-content">
                    <padding>
                        <Insets bottom="32.0" left="32.0" right="32.0" top="24.0" />
                    </padding>
                    <Label styleClass="section-title" text="Queue" />
                    <Label styleClass="supporting-text"
                           text="Current availability is informational and does not reserve equipment or determine rejection." />
                    <Label fx:id="emptyQueueLabel" managed="false" visible="false"
                           styleClass="catalog-empty-text" text="No LoanRequests are currently pending." />
                    <TableView fx:id="requestsTable" prefHeight="245.0">
                        <columns>
                            <TableColumn fx:id="requestIdColumn" visible="false" text="Request ID" />
                            <TableColumn fx:id="memberColumn" prefWidth="185.0" text="Member" />
                            <TableColumn fx:id="equipmentTypeColumn" prefWidth="215.0" text="Equipment type" />
                            <TableColumn fx:id="requestedQuantityColumn" prefWidth="100.0" text="Requested" />
                            <TableColumn fx:id="availableQuantityColumn" prefWidth="100.0" text="Available" />
                            <TableColumn fx:id="startDateColumn" visible="false" text="Start date" />
                            <TableColumn fx:id="endDateColumn" visible="false" text="End date" />
                            <TableColumn fx:id="requestedAtColumn" prefWidth="190.0" text="Submitted" />
                            <TableColumn fx:id="detailsColumn" visible="false" text="Details" />
                        </columns>
                    </TableView>
                    <VBox spacing="6.0" styleClass="account-form-card">
                        <Label styleClass="section-title" text="Selected request" />
                        <Label fx:id="requestDetailsLabel" styleClass="supporting-text" wrapText="true"
                               text="Select a request to see its dates, details, and ID." />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="shell-bar">
            <padding><Insets bottom="12.0" left="24.0" right="24.0" top="12.0" /></padding>
            <Button fx:id="approveRequestButton" mnemonicParsing="true"
                    onAction="#approveSelectedRequest" styleClass="primary-button"
                    text="_Approve selected request" />
            <Button fx:id="rejectRequestButton" mnemonicParsing="true"
                    onAction="#rejectSelectedRequest" styleClass="danger-button"
                    text="_Reject selected request" />
            <Button mnemonicParsing="true" onAction="#refreshRequests"
                    styleClass="secondary-button" text="_Refresh" />
            <Label fx:id="statusLabel" styleClass="error-text" wrapText="true" />
        </HBox>
    </bottom>
</BorderPane>
