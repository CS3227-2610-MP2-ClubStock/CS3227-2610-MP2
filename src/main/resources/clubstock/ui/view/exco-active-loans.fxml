<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="clubstock.ui.controller.ExcoActiveLoansController" spacing="12" styleClass="role-shell,exco-shell">
  <children><Label text="Active Loans" styleClass="screen-title"/><Label text="Unresolved Loans and their computed overdue state." styleClass="supporting-text"/><TableView fx:id="loansTable"><columns><TableColumn fx:id="memberColumn" text="Member"/><TableColumn fx:id="typeColumn" text="Equipment type"/><TableColumn fx:id="equipmentIdColumn" text="Equipment ID"/><TableColumn fx:id="statusColumn" text="Status"/><TableColumn fx:id="startedColumn" text="Started"/><TableColumn fx:id="endColumn" text="End date"/><TableColumn fx:id="overdueColumn" text="Overdue"/></columns></TableView><HBox spacing="12"><children><Button text="_Refresh" mnemonicParsing="true" onAction="#refresh"/><Button text="_Back" mnemonicParsing="true" onAction="#goBack"/><Label fx:id="statusLabel" styleClass="supporting-text"/></children></HBox></children>
</VBox>
