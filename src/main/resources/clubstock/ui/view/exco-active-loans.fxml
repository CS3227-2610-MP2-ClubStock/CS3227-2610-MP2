<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="clubstock.ui.controller.ExcoActiveLoansController"
            styleClass="role-shell,exco-shell">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="shell-bar">
            <padding><Insets top="16" right="24" bottom="16" left="24" /></padding>
            <Button text="_Back" mnemonicParsing="true" onAction="#goBack" styleClass="secondary-button" />
            <VBox spacing="2">
                <Label text="Active Loans" styleClass="screen-title" />
                <Label text="Unresolved Loans and their computed overdue state." styleClass="supporting-text" />
            </VBox>
        </HBox>
    </top>
    <center>
        <TableView fx:id="loansTable">
            <BorderPane.margin><Insets top="24" right="24" bottom="16" left="24" /></BorderPane.margin>
            <columns>
                <TableColumn fx:id="memberColumn" prefWidth="130" text="Member" />
                <TableColumn fx:id="typeColumn" prefWidth="145" text="Equipment type" />
                <TableColumn fx:id="equipmentIdColumn" prefWidth="120" text="Equipment ID" />
                <TableColumn fx:id="statusColumn" prefWidth="120" text="Status" />
                <TableColumn fx:id="startedColumn" prefWidth="175" text="Started" />
                <TableColumn fx:id="endColumn" prefWidth="110" text="End date" />
                <TableColumn fx:id="overdueColumn" prefWidth="75" text="Overdue" />
            </columns>
        </TableView>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="shell-bar">
            <padding><Insets top="12" right="24" bottom="12" left="24" /></padding>
            <Button text="_Refresh" mnemonicParsing="true" onAction="#refresh" styleClass="secondary-button" />
            <Label fx:id="statusLabel" styleClass="supporting-text" wrapText="true" />
        </HBox>
    </bottom>
</BorderPane>
