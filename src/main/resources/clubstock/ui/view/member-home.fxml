<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="clubstock.ui.controller.MemberHomeController"
            styleClass="role-shell, member-shell">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="shell-bar">
            <padding>
                <Insets top="16" right="24" bottom="16" left="24"/>
            </padding>
            <children>
                <VBox HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="ClubStock" styleClass="shell-brand"/>
                        <Label text="MEMBER WORKSPACE" styleClass="shell-role"/>
                    </children>
                </VBox>
                <Button text="_Log out" mnemonicParsing="true" onAction="#logout"
                        styleClass="secondary-button"/>
            </children>
        </HBox>
    </top>
    <center>
        <StackPane fx:id="contentHost" styleClass="content-host">
            <padding>
                <Insets top="32" right="32" bottom="32" left="32"/>
            </padding>
            <children>
                <VBox maxWidth="820" spacing="18" styleClass="surface-card">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="16">
                            <children>
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="MEMBER CATALOGUE" styleClass="eyebrow"/>
                                        <Label text="Equipment catalogue" styleClass="screen-title"/>
                                    </children>
                                </VBox>
                                <Button text="_Refresh" mnemonicParsing="true"
                                        onAction="#refresh" styleClass="secondary-button"/>
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <children>
                                <Button text="_New request" mnemonicParsing="true"
                                        onAction="#openRequestEntry" styleClass="primary-button" />
                                <Button text="_My requests" mnemonicParsing="true"
                                        onAction="#openOwnRequests" styleClass="secondary-button" />
                                <Button text="_My loans" mnemonicParsing="true"
                                        onAction="#openMyLoans" styleClass="secondary-button" />
                            </children>
                        </HBox>
                        <Label fx:id="emptyStateLabel" text="No equipment is currently offered"
                               styleClass="catalog-empty-text" visible="false" managed="false"
                               wrapText="true"/>
                        <Label fx:id="errorLabel" text="" styleClass="error-text" minHeight="24"
                               visible="false" managed="false" wrapText="true"/>
                        <ListView fx:id="catalogListView" styleClass="catalog-list-view"
                                  accessibleText="Offered equipment types and available quantities"
                                  prefHeight="360" VBox.vgrow="ALWAYS"/>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </center>
</BorderPane>
